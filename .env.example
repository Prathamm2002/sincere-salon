# ---------------------------------------------------------------------------
#  Copy to .env for local development. NEVER commit the real .env.
#  On Vercel these go in Project → Settings → Environment Variables.
# ---------------------------------------------------------------------------

# Neon connection string. Use the POOLED one (host contains "-pooler"),
# which is what a serverless runtime needs.
# Neon dashboard → Connection Details → Pooled connection.
DATABASE_URL="postgresql://user:password@ep-xxx-pooler.region.aws.neon.tech/neondb?sslmode=require"

# Admin login for /admin.
ADMIN_USERNAME="admin"

# Generate with:  npm run hash-password
# Paste the whole scrypt$... string, quoted.
ADMIN_PASSWORD_HASH="scrypt$...$..."

# Signs the admin session cookie. Any long random string.
# Generate with:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET="change-me-to-a-long-random-string"
